DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# When DB_ENGINE=postgres, these override DB_* (eval RDS + local tunnel 5433)
PG_DB_HOST=
PG_DB_PORT=5433
PG_DB_NAME=
PG_DB_USER=
PG_DB_PASSWORD=

# Optional: legacy MySQL for ETL (import_legacy_*) — defaults to DB_* if unset
LEGACY_DB_NAME=production
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=

# Cognito - user authentication and authorization
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional comma-separated list (web + mobile app clients)
COGNITO_CLIENT_IDS=
COGNITO_CLIENT_SECRET=
AWS_PROFILE=
AWS_DEFAULT_REGION=

# Private media (user photos under User-profile/{cognito_sub}/)
MEDIA_S3_BUCKET=gazebo-media-files

# Warehouse app force-update (GET /app/version/?platform=android)
APP_MIN_VERSION_ANDROID=1.0.1
APP_LATEST_VERSION_ANDROID=1.0.1
APP_UPDATE_MESSAGE=Hand this device to IT to install the update.
# Same value as GitHub secret APP_VERSION_API_TOKEN (CI PUT /app/version/)
APP_VERSION_API_TOKEN=